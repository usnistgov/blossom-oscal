    <!--
        Examine Leveraged ATO
    --> 
    <local-definitions>
        <activity uuid="52277182-1ba3-4cb6-8d96-b1b97aaf9d6b">
            <title>Examine Leveraged ATO </title>
            <description>
                <p>Examine Leveraged System's ATO to ensure it's validity.</p>
            </description>
            <prop name="method" value="EXAMINE" />
            <step uuid="733e3cbf-e398-46b6-9c02-a2cb534c341e">
                <title>Obtain Access to ATO</title>
                <description>
                    <p>The assessor will obtain access to the AWS infrastructure ATO and examines the ATO signature and expiration date.</p> 
                </description>
            </step>
            <related-controls>
                <control-selection>
                    <include-control control-id="ac-2.a" />
                </control-selection>
            </related-controls>
        <responsible-role role-id="sys-sec-assessor">
            <party-uuid>132953a9-640c-46f7-9de9-3fa15ec99361</party-uuid>
        </responsible-role>

        </activity>
    </local-definitions>
