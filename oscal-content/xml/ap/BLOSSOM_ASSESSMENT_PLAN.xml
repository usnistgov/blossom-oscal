    <task uuid="9637212f-dbc9-4892-ac1f-be6a75faf105" type="action">
        <title>Assessing Implementation of AC-2.a</title>
        <description>
            <p>The ISSO will review Blossom privileged and non-privileged accounts (review the NGAC
                implementation in the blockchain; review the ACL for Blossom; review privileges for
                each type of Blossom account); and review AWS generated printout of privileged and
                non-privileged Blossom users and their associated privileges on the Blossom system.
                Execute script abcd.py to parse SSP and extract documented roles. Compare between
                ACL and system.</p>
        </description>
        <prop name="control-statement" uuid="eadf747f-a02c-4e80-8661-ec1cf8dd11e8"
            ns="http://csrc.nist.gov/ns/blossom/1.0" value="ac-2.a" group="ac-2.a" />
        <prop name="assessment-objective" uuid="774c3146-452f-4201-bed4-2483a873a80a"
            ns="http://csrc.nist.gov/ns/blossom/1.0" value="ac-2_obj.a" group="ac-2.a" />
        <prop name="assessment-method" uuid="917eb76b-d62f-4164-8cd6-815c554cf1cc"
            ns="http://csrc.nist.gov/ns/blossom/1.0" value="ac-2_asm-test" group="ac-2.a" />
        <link href="../script/abcd.py" rel="assessment-method" />
